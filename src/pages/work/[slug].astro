---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import Localized from '../../components/Localized.astro';
import { getText, projects, ui } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`Lucía Alegria - ${getText(project.title)}`}>
  <article class="project-page">
    <header class="project-hero">
      <div class="project-hero-copy">
        <p class="meta"><Localized value={project.category} /></p>
        <h1><Localized value={project.title} /></h1>
        <p><Localized value={project.summary} /></p>
        <div class="tag-list">
          {project.tags.map((tag) => <span><Localized value={tag} /></span>)}
        </div>
      </div>
      {project.heroImage && (
        <figure>
          <img src={project.heroImage} alt={project.heroAlt ?? getText(project.title)} />
        </figure>
      )}
    </header>

    {project.sections.map((section) => <ProjectSection section={section} />)}

    <nav class="project-more" aria-label="More work">
      <p><Localized value={ui.moreWork} /></p>
      <div>
        {projects
          .filter((item) => item.slug !== project.slug)
          .slice(0, 3)
          .map((item) => <a href={`/work/${item.slug}/`}><Localized value={item.title} /></a>)}
      </div>
    </nav>
  </article>
</BaseLayout>
