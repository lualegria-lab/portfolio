---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import Localized from '../../components/Localized.astro';
import { getText, projects, ui } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const projectHeroAlt = project.heroAlt ?? getText(project.title);
const projectImage = project.heroImage ?? project.thumbnail[0];
---

<BaseLayout
  title={`Lucía Alegria - ${getText(project.title)}`}
  description={getText(project.summary)}
  image={projectImage}
  type="article"
>
  <article class:list={['project-page', `project-${project.slug}`]}>
    <header class="project-hero">
      <div class="project-hero-copy">
        <p class="meta"><Localized value={project.category} /></p>
        <h1><Localized value={project.title} /></h1>
        <p><Localized value={project.summary} /></p>
        <div class="tag-list">
          {project.tags.map((tag) => <span><Localized value={tag} /></span>)}
        </div>
      </div>
      {project.heroImage && (
        <figure>
          <button
            class="image-expand"
            type="button"
            data-lightbox-trigger
            data-lightbox-src={project.heroImage}
            data-lightbox-alt={projectHeroAlt}
            aria-label={`Open ${projectHeroAlt} full screen`}
          >
            <img src={project.heroImage} alt={projectHeroAlt} />
          </button>
        </figure>
      )}
    </header>

    {project.sections.map((section) => <ProjectSection section={section} />)}

    <nav class="project-more" aria-label="More work">
      <a class="project-more-home" href="/"><Localized value={ui.moreWork} /></a>
      <div>
        {projects
          .filter((item) => item.slug !== project.slug)
          .slice(0, 3)
          .map((item) => <a href={`/work/${item.slug}/`}><Localized value={item.title} /></a>)}
      </div>
    </nav>
  </article>
</BaseLayout>
