---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { certificates, ui } from '../data/portfolio';
---

<BaseLayout active="certificates" title="Lucía Alegria - Certificates">
  <section class="page-shell">
    <div class="page-heading">
      <p class="meta"><Localized value={ui.certificatesEyebrow} /></p>
      <h1><Localized value={ui.certificatesTitle} /></h1>
    </div>
    <div class="certificate-grid">
      {certificates.map((certificate, index) => (
        <figure>
          <img src={certificate} alt={`Certificate ${index + 1}`} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
