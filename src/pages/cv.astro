---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { ui } from '../data/portfolio';

const description =
  'Resume of Lucía Alegria, communications specialist and UX designer based in Barcelona.';
---

<BaseLayout active="cv" title="Lucía Alegria - CV" description={description}>
  <section class="page-shell">
    <div class="page-heading">
      <p class="meta"><Localized value={ui.cvEyebrow} /></p>
      <h1><Localized value={ui.cvTitle} /></h1>
    </div>
    <div class="cv-pages">
      <img src="/assets/cv-page-1.png" alt="Lucía Alegria resume page 1" />
      <img src="/assets/cv-page-2.png" alt="Lucía Alegria resume page 2" />
    </div>
  </section>
</BaseLayout>
