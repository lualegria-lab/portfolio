---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { ui } from '../data/portfolio';
---

<BaseLayout active="cv" title="Lucía Alegria - CV">
  <section class="page-shell">
    <div class="page-heading">
      <p class="meta"><Localized value={ui.cvEyebrow} /></p>
      <h1>CV</h1>
    </div>
    <div class="cv-pages">
      <img src="/assets/cv-page-1.png" alt="CV page 1" />
      <img src="/assets/cv-page-2.png" alt="CV page 2" />
    </div>
  </section>
</BaseLayout>
